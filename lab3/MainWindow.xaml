<Window x:Class="lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Компьютерная графика — Полигоны и аффинные преобразования"
        Width="1100" Height="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
     
        <StackPanel DockPanel.Dock="Left" Width="280" Background="#F0F0F0"
                    Margin="0" VerticalAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">

             
                    <GroupBox Header="Режим работы" FontWeight="Bold">
                        <StackPanel>
                            <RadioButton x:Name="RbCreate" Content="Создание полигона"
                                         IsChecked="True" Margin="4"
                                         Checked="ModeChanged"/>
                            <RadioButton x:Name="RbSelect" Content="Выбор полигона"
                                         Margin="4" Checked="ModeChanged"/>
                            <RadioButton x:Name="RbPivot" Content="Задать точку (для преобр.)"
                                         Margin="4" Checked="ModeChanged"/>
                        </StackPanel>
                    </GroupBox>

        
                    <GroupBox Header="Полигоны" FontWeight="Bold">
                        <StackPanel>
                            <Button Content="Завершить текущий полигон"
                                    Click="FinishPolygon_Click"/>
                            <Button Content="Очистить сцену" Background="#FFCCCC"
                                    Click="ClearScene_Click"/>
                            <ListBox x:Name="LbPolygons" Height="100" Margin="4"
                                     SelectionChanged="PolygonSelectionChanged"/>
                        </StackPanel>
                    </GroupBox>

               
                    <GroupBox Header="Аффинные преобразования" FontWeight="Bold">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="Gray" Margin="4,2">
                                Выберите полигон в списке, затем примените преобразование.
                            </TextBlock>

                            
                            <Expander Header="1. Смещение (dx, dy)" IsExpanded="True">
                                <StackPanel Margin="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="dx:"/>
                                        <TextBox x:Name="TbDx" Text="20"/>
                                        <Label Content="dy:"/>
                                        <TextBox x:Name="TbDy" Text="20"/>
                                    </StackPanel>
                                    <Button Content="Применить сдвиг"
                                            Click="ApplyTranslation_Click"/>
                                </StackPanel>
                            </Expander>

                         
                            <Expander Header="2. Поворот вокруг центра">
                                <StackPanel Margin="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Угол (°):"/>
                                        <TextBox x:Name="TbAngleCenter" Text="30" Width="50"/>
                                    </StackPanel>
                                    <Button Content="Повернуть"
                                            Click="ApplyRotationCenter_Click"/>
                                </StackPanel>
                            </Expander>

                          
                            <Expander Header="3. Поворот вокруг точки">
                                <StackPanel Margin="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Угол (°):"/>
                                        <TextBox x:Name="TbAnglePivot" Text="45" Width="50"/>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="DarkBlue"
                                               TextWrapping="Wrap" Margin="2">
                                        Переключитесь в режим «Задать точку»,
                                        кликните на холст, затем нажмите кнопку.
                                    </TextBlock>
                                    <TextBlock x:Name="TbPivotInfo" FontSize="11"
                                               Foreground="Red" Margin="2">
                                        Точка не задана
                                    </TextBlock>
                                    <Button Content="Повернуть вокруг точки"
                                            Click="ApplyRotationPivot_Click"/>
                                </StackPanel>
                            </Expander>

                       
                            <Expander Header="4. Масштаб (центр)">
                                <StackPanel Margin="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Sx:"/>
                                        <TextBox x:Name="TbSxCenter" Text="1.5" Width="50"/>
                                        <Label Content="Sy:"/>
                                        <TextBox x:Name="TbSyCenter" Text="1.5" Width="50"/>
                                    </StackPanel>
                                    <Button Content="Масштабировать"
                                            Click="ApplyScaleCenter_Click"/>
                                </StackPanel>
                            </Expander>

                        
                            <Expander Header="5. Масштаб (точка)">
                                <StackPanel Margin="8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Sx:"/>
                                        <TextBox x:Name="TbSxPivot" Text="2.0" Width="50"/>
                                        <Label Content="Sy:"/>
                                        <TextBox x:Name="TbSyPivot" Text="2.0" Width="50"/>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="DarkBlue"
                                               TextWrapping="Wrap" Margin="2">
                                        Используйте ту же заданную точку (режим «Задать точку»).
                                    </TextBlock>
                                    <Button Content="Масштабировать вокруг точки"
                                            Click="ApplyScalePivot_Click"/>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </StackPanel>

      
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="TbStatus" Text="Кликайте по холсту для создания полигона"/>
            </StatusBarItem>
        </StatusBar>

       
        <Border BorderBrush="Gray" BorderThickness="1" Margin="4">
            <Canvas x:Name="MainCanvas" Background="White"
                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                    ClipToBounds="True"/>
        </Border>
    </DockPanel>
</Window>