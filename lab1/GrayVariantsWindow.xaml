<Window x:Class="color_converter.GrayVariantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:color_converter"
        mc:Ignorable="d"
        Title="Задача 1: Оттенки серого и гистограммы" Height="700" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="10"
              Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="LoadImageButton"
                    Grid.Column="0"
                    Content="Загрузить изображение"
                    Click="LoadImageButton_Click"
                    Width="140"
                    Margin="5"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

            <Button x:Name="ConvertButton"
                    Grid.Column="1"
                    Content="Преобразовать + Гистограммы"
                    Click="ConvertButton_Click"
                    Width="180"
                    Margin="5"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

            <Button x:Name="BackToMain"
                    Grid.Column="3"
                    Content="В меню"
                    Click="ButtonBack_Click"
                    Width="80"
                    Margin="5"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="Оригинальное изображение"
                               HorizontalAlignment="Center"
                               Margin="5"
                               FontWeight="Bold" />
                    <Image x:Name="OriginalImage"
                           Stretch="Uniform"
                           Height="250" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="Гистограмма NTSC"
                               HorizontalAlignment="Center"
                               Margin="5"
                               FontWeight="Bold" />
                    <Canvas x:Name="HistogramCanvas1"
                            Height="200"
                            Background="White" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="Гистограмма BT.709"
                               HorizontalAlignment="Center"
                               Margin="5"
                               FontWeight="Bold" />
                    <Canvas x:Name="HistogramCanvas2"
                            Height="200"
                            Background="White" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="Разность"
                               HorizontalAlignment="Center"
                               Margin="5"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Image x:Name="GrayDifferenceImage"
                           Stretch="Uniform"
                           Height="250" />
                </StackPanel>
            </Border>


            <Border Grid.Column="1"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="NTSC: 0.299R + 0.587G + 0.114B"
                               HorizontalAlignment="Center"
                               Margin="5"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Image x:Name="GrayscaleImage1"
                           Stretch="Uniform"
                           Height="250" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="5">
                <StackPanel>
                    <TextBlock Text="BT.709: 0.2126R + 0.7152G + 0.0722B"
                               HorizontalAlignment="Center"
                               Margin="5"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Image x:Name="GrayscaleImage2"
                           Stretch="Uniform"
                           Height="250" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
