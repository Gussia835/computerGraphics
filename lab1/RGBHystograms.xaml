<Window x:Class="color_converter.RGBHystograms"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Задача 2: Каналы RGB и гистограммы" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Button x:Name="buttonLoad" Content="Загрузить" HorizontalAlignment="Left" Margin="25,18,0,0" VerticalAlignment="Top" Width="95" Height="28" Click="ButtonLoad_Click"/>
        <Button x:Name="buttonProcess" Content="Построить" HorizontalAlignment="Left" Margin="135,18,0,0" VerticalAlignment="Top" Width="95" Height="28" IsEnabled="False" Click="ButtonProcess_Click"/>

        <TextBlock HorizontalAlignment="Left" Margin="25,55,0,0" TextWrapping="Wrap" Text="Оригинал" VerticalAlignment="Top" FontWeight="Bold"/>
        <Image x:Name="OriginalImage" HorizontalAlignment="Left" Height="165" Margin="25,75,0,0" VerticalAlignment="Top" Width="180" Stretch="Uniform" AutomationProperties.Name="OriginalImage"/>

        <TextBlock HorizontalAlignment="Left" Margin="228,52,0,0" TextWrapping="Wrap" Text="Канал R" VerticalAlignment="Top" FontWeight="Bold" Foreground="DarkRed"/>
        <Image x:Name="imageRed" HorizontalAlignment="Left" Height="165" Margin="228,72,0,0" VerticalAlignment="Top" Width="180" Stretch="Uniform"/>

        <TextBlock HorizontalAlignment="Left" Margin="432,58,0,0" TextWrapping="Wrap" Text="Канал G" VerticalAlignment="Top" FontWeight="Bold" Foreground="DarkGreen"/>
        <Image x:Name="imageGreen" HorizontalAlignment="Left" Height="165" Margin="432,78,0,0" VerticalAlignment="Top" Width="180" Stretch="Uniform"/>

        <TextBlock HorizontalAlignment="Left" Margin="635,54,0,0" TextWrapping="Wrap" Text="Канал B" VerticalAlignment="Top" FontWeight="Bold" Foreground="DarkBlue"/>
        <Image x:Name="imageBlue" HorizontalAlignment="Left" Height="165" Margin="635,74,0,0" VerticalAlignment="Top" Width="180" Stretch="Uniform"/>

        <TextBlock HorizontalAlignment="Left" Margin="228,265,0,0" TextWrapping="Wrap" Text="Гистограмма R" VerticalAlignment="Top" FontWeight="Bold"/>
        <Canvas x:Name="canvasHistR" HorizontalAlignment="Left" Height="140" Margin="228,285,0,0" VerticalAlignment="Top" Width="180" Background="White"/>

        <TextBlock HorizontalAlignment="Left" Margin="432,262,0,0" TextWrapping="Wrap" Text="Гистограмма G" VerticalAlignment="Top" FontWeight="Bold"/>
        <Canvas x:Name="canvasHistG" HorizontalAlignment="Left" Height="140" Margin="432,282,0,0" VerticalAlignment="Top" Width="180" Background="White"/>

        <TextBlock HorizontalAlignment="Left" Margin="634,268,0,0" TextWrapping="Wrap" Text="Гистограмма B" VerticalAlignment="Top" FontWeight="Bold"/>
        <Canvas x:Name="canvasHistB" HorizontalAlignment="Left" Height="140" Margin="634,288,0,0" VerticalAlignment="Top" Width="180" Background="White"/>

        <Button x:Name="buttonBack" Content="Назад в меню" HorizontalAlignment="Left" Margin="2,590,0,0" VerticalAlignment="Top" Width="120" Height="28" 
        Click="ButtonBack_Click"/>
    </Grid>
    
    
</Window>