<Window x:Class="Raster.TriangleRasterizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raster"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="450"
        Width="800"
        Loaded="Window_Loaded">
    <Border Background="#2C3E50">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="0"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="DrawTriangleButton"
                            Grid.Column="0"
                            Content="Нарисовать треугольник"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="15,10"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="#3498DB"
                            Foreground="White"
                            BorderBrush="#2980B9"
                            Click="DrawTriangleButton_Click">
                    </Button>

                    <Button x:Name="ClearSelectedPointsButton"
                            Grid.Column="2"
                            Content="Очистить точки"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Padding="15,10"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="#3498DB"
                            Foreground="White"
                            BorderBrush="#2980B9"
                            Click="ClearSelectedPointsButton_Click">
                        
                    </Button>

                    <Button x:Name="BackToMain"
                            Grid.Column="4"
                            Content="В меню"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="25,10"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="#E74C3C"
                            Foreground="White"
                            BorderBrush="#C0392B"
                            BorderThickness="1"
                            Click="ButtonBack_Click">
                        
                    </Button>

                </Grid>
            </Border>

            <Border Grid.Row="1">
                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#ECF0F1"
                            BorderBrush="#BDC3C7"
                            BorderThickness="2"
                            Margin="10"
                            Name="ImageContainer">
                        <Grid>
                            <Image x:Name="DisplayImage"
                                   Stretch="Fill"
                                   MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                   Cursor="Cross" />
                            <Canvas x:Name="PointsCanvas" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0">
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0">
                                <Border Background="#FF4444"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="R:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="RedValue1"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#44FF44"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="G:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="GreenValue1"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#4444FF"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="BlueValue1"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1">
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0">
                                <Border Background="#FF4444"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="R:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="RedValue2"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#44FF44"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="G:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="GreenValue2"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#4444FF"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="BlueValue2"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2">
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Margin="10,0">
                                <Border Background="#FF4444"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="R:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="RedValue3"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#44FF44"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="G:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="GreenValue3"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#4444FF"
                                        CornerRadius="3"
                                        Margin="2"
                                        Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="B:"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,3,0" />
                                        <TextBox x:Name="BlueValue3"
                                                 Width="40"
                                                 Text="255"
                                                 MaxLength="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Background="White"
                                                 BorderBrush="#CCCCCC"
                                                 BorderThickness="1" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
