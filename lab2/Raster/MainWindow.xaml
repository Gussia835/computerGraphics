<Window x:Class="Raster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор задания" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Компьютерная графика" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <Button Content="Задание 1: Заливка и границы"
                Width="250" Height="40" Margin="10"
                Click="ButtonTask1_Click" FontSize="14"/>

        <Button Content="Задание 2: (В разработке)"
                Width="250" Height="40" Margin="10"
                Click="ButtonTask2_Click" FontSize="14"/>

        <Button Content="Задание 3: (В разработке)"
                Width="250" Height="40" Margin="10"
                Click="ButtonTask3_Click" FontSize="14"/>
    </StackPanel>
</Window>