<Window x:Class="Raster.FillImage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 1: Заливка и Границы" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10" Background="#F0F0F0">
            <TextBlock Text="Управление" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="1. Рисование: Зажми ЛКМ и веди мышь." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>

            <Button Content="Тестовый круг" Click="TestCircle_Click" Margin="0,5" Padding="5" Background="#D0D0FF"/>
            <Button Content="Тестовый паттерн" Click="CreateTestPattern_Click" Margin="0,5" Padding="5" Background="#FFD0FF"/>

            <Separator Margin="0,10"/>

            <Button Content="Загрузить паттерн (1б)" Click="LoadPattern_Click" Margin="0,5" Padding="5"/>
            <CheckBox x:Name="CbCyclic" Content="Циклический паттерн" IsChecked="True" Margin="0,0,0,10"/>

            <Separator Margin="0,10"/>

            <Button Content="Залить цветом (1а)" Click="FillColor_Click" Background="#FFD0D0" Margin="0,5" Padding="5"/>
            <Button Content="Залить паттерном (1б)" Click="FillPattern_Click" Background="#FFD0D0" Margin="0,5" Padding="5"/>
            <Button Content="Обвести границу (1в)" Click="TraceBoundary_Click" Background="#D0FFD0" Margin="0,5" Padding="5"/>

            <Button Content="Очистить холст" Click="ClearCanvas_Click" Margin="0,20,0,0" Padding="5"/>

            <TextBlock x:Name="StatusText" Text="Готово к работе" FontSize="11" Foreground="Blue" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="10" Background="White">
            <Image Name="MyImage"
                    Stretch="None"
                    MouseDown="MyImage_MouseDown" 
                     MouseMove="MyImage_MouseMove" 
                    MouseUp="MyImage_MouseUp"
                    Cursor="Cross"/>
        </Border>
    </Grid>
</Window>