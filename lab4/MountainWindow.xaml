<Window x:Class="lab4.MountainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание 2: Midpoint Displacement" Height="600" Width="1000"
        Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="15" Background="#2D2D30">
            <TextBlock Text="Параметры генерации" FontSize="16" Foreground="White" FontWeight="Bold" Margin="10"/>

            <TextBlock Text="Текущий шаг (Итерация):" Foreground="White" Margin="10,5,10,0"/>
            <DockPanel Margin="10,0,10,10">
                <TextBlock x:Name="lblSteps" Text="5" Foreground="White" Width="20" DockPanel.Dock="Right" TextAlignment="Right"/>
                <Slider x:Name="sliderSteps" Minimum="0" Maximum="10" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Parameter_Changed"/>
            </DockPanel>

            <TextBlock Text="Шероховатость (Roughness):" Foreground="White" Margin="10,5,10,0"/>
            <DockPanel Margin="10,0,10,10">
                <TextBlock x:Name="lblRoughness" Text="0.5" Foreground="White" Width="30" DockPanel.Dock="Right" TextAlignment="Right"/>
                <Slider x:Name="sliderRoughness" Minimum="0.0" Maximum="1.5" Value="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Parameter_Changed"/>
            </DockPanel>

            <TextBlock Text="Левый край высоты:" Foreground="White" Margin="10,5,10,0"/>
            <Slider x:Name="sliderLeft" Minimum="0" Maximum="1" Value="0.3" Margin="10,0,10,10" ValueChanged="Parameter_Changed"/>

            <TextBlock Text="Правый край высоты:" Foreground="White" Margin="10,5,10,0"/>
            <Slider x:Name="sliderRight" Minimum="0" Maximum="1" Value="0.4" Margin="10,0,10,10" ValueChanged="Parameter_Changed"/>

            <TextBlock Text="Зерно (Seed):" Foreground="White" Margin="10,5,10,0"/>
            <TextBox x:Name="txtSeed" Text="42" Margin="10,0,10,10" Padding="3" Background="#3F3F46" Foreground="White" BorderBrush="#555"/>

            <Button Content="Новый Seed" Margin="10,15,10,10" Padding="5" Click="BtnNewSeed_Click" Background="#007ACC" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <Border Grid.Column="1" Margin="15" Background="#111" CornerRadius="5" BorderBrush="#333" BorderThickness="1">
            <Canvas x:Name="MountainCanvas" SizeChanged="MountainCanvas_SizeChanged"/>
        </Border>
    </Grid>
</Window>

