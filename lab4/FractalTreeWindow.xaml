<Window x:Class="lab4.FractalTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab4"
        mc:Ignorable="d"
        Title="FractalTreeWindow" Height="650" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C3E50"
                BorderBrush="#1A252F"
                BorderThickness="0,0,0,2"
                Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="LoadButton"
                        Grid.Column="0"
                        Content="Загрузить файл"
                        VerticalAlignment="Center"
                        Padding="12,12"
                        Margin="0,0,8,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#3498DB"
                        Foreground="White"
                        BorderBrush="#2980B9"
                        BorderThickness="1"
                        Click="LoadButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor"
                                    Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#2980B9" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <TextBlock Text="Итерации:"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBox x:Name="IterationsTextBox"
                             Text="5"
                             Width="50"
                             FontSize="14"
                             Padding="4"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <TextBlock Text="Случ. :"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBox x:Name="RandomTextBox"
                             Text="8"
                             Width="50"
                             FontSize="14"
                             Padding="4"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <Button x:Name="DrawButton"
                        Grid.Column="3"
                        Content="Нарисовать"
                        VerticalAlignment="Center"
                        Padding="12,12"
                        Margin="0,0,8,0"
                        FontSize="16"
                        FontWeight="Bold"
                        Background="#27AE60"
                        Foreground="White"
                        BorderBrush="#1E8449"
                        BorderThickness="1"
                        Click="DrawButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor"
                                    Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#1E8449" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="CloseButton"
                        Grid.Column="5"
                        Content="В меню"
                        VerticalAlignment="Center"
                        Padding="12,12"
                        FontSize="14"
                        FontWeight="Bold"
                        Background="#E74C3C"
                        Foreground="White"
                        BorderBrush="#C0392B"
                        BorderThickness="1"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor"
                                    Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter Property="Background"
                                            Value="#C0392B" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#ECF0F1">
                <Canvas x:Name="DrawCanvas"
                        Background="White"
                        ClipToBounds="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
